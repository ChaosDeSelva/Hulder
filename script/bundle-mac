#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
for candidate in "${HULDER_PYTHON:-python3}" python3.14 python3.13 python3.12 python3.11; do
  if command -v "$candidate" >/dev/null && "$candidate" -c 'import tomllib' 2>/dev/null; then
    exec "$candidate" script/package-hulder.py "$@"
  fi
done
echo 'Python 3.11 or newer is required; set HULDER_PYTHON to its executable.' >&2
exit 1
